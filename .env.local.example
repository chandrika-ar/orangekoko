# Copy this file to .env.local and fill in real values before running locally or deploying.

# Stripe (https://dashboard.stripe.com/apikeys) — use a test key while developing.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sanity (https://sanity.io) — free account, powers the /studio admin for
# adding/editing products. Without these, the site falls back to the local
# sample catalogue in src/lib/products.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
