# Copy this file to .env.local and fill in real values before running locally or deploying.

# Stripe (https://dashboard.stripe.com/apikeys) — use a test key while developing.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe Dashboard → Developers → Webhooks, once you add an endpoint
# pointing at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# Sanity (https://sanity.io) — free account, powers the /studio admin for
# adding/editing products. Without these, the site falls back to the local
# sample catalogue in src/lib/products.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity → API → Tokens → Add API token, role "Editor". Lets the Stripe
# webhook mark a product sold automatically after payment. Keep this
# secret — never prefix it with NEXT_PUBLIC_.
SANITY_API_TOKEN=

# Customer accounts (email sign-in + a wishlist tied to the account).
# Without these, /account shows a "not set up yet" message and wishlists
# stay local-only (localStorage), exactly like before.
#
# 1. Vercel project → Storage → create a Postgres database, then run
#    db/schema.sql against it once (Storage → your database → Query tab).
#    Vercel injects POSTGRES_URL automatically once connected.
# 2. Generate a random secret: `openssl rand -base64 32`.
AUTH_SECRET=
# 3. Sign up at https://resend.com, verify your domain (adds a couple of
#    DNS records, same idea as the Vercel domain setup), then
#    Resend → API Keys → Create API Key.
AUTH_RESEND_KEY=
# 4. The "from" address for sign-in emails — must be on a domain you
#    verified in Resend (e.g. login@orangekoko.com). Leave unset to use
#    Resend's shared test address, which only delivers to your own
#    Resend account email.
AUTH_EMAIL_FROM=
